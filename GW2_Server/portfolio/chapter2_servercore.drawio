          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- START RETURNS -->
        <mxCell id="s5" value="_isRunning = true  /  service-&gt;Start() 반환"
          style="rounded=0;whiteSpace=wrap;html=1;
