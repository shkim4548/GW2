        </mxCell>

        <!-- MAIN THREAD LOOP -->
        <mxCell id="main_loop" value="⑦ Main Thread — 30 FPS 게임 루프
deltaTime = clamp((now - lastTick) * 0.001f,  0.0f, 0.1f)
if (deltaTime &gt;= 0.033f)  →  GLobby-&gt;LobbyUpdate(deltaTime)
Sleep(1)   ← BusyLoop 방지"
          style="rounded=0;whiteSpace=wrap;html=1;
                 fillColor=#e8f5e9;strokeColor=#43a047;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="184" y="1240" width="700" height="80" as="geometry"/>
        </mxCell>

