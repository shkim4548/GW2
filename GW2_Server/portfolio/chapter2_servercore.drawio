          vertex="1" parent="1">
          <mxGeometry x="84" y="20" width="1000" height="40" as="geometry"/>
        </mxCell>

        <!-- START -->
        <mxCell id="s0" value="main() 진입"
          style="ellipse;whiteSpace=wrap;html=1;
                 fillColor=#1a1a2e;fontColor=#ffffff;strokeColor=#1a1a2e;
                 fontSize=13;fontStyle=1;"
          vertex="1" parent="1">
          <mxGeometry x="434" y="80" width="200" height="50" as="geometry"/>
        </mxCell>

        <!-- DB INIT -->
        <mxCell id="s1" value="① DB 초기화
GDBConnectionPool-&gt;Connect(ODBC 연결문자열)
dbSync.Synchronize(&apos;GameDB.xml&apos;)  →  스키마 자동 동기화"
          style="rounded=0;whiteSpace=wrap;html=1;
                 fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;
                 align=left;spacingLeft=10;"
          vertex="1" parent="1">
          <mxGeometry x="284" y="170" width="500" height="65" as="geometry"/>
        </mxCell>

        <!-- PACKET HANDLER INIT -->
        <mxCell id="s2" value="② ClientPacketHandler::Init()
for i in 0..UINT16_MAX:  GPacketHandler[i] = Handle_INVALID
GPacketHandler[PKT_C_MOVE]  = lambda → HandlePacket&lt;C_MOVE&gt;
GPacketHandler[PKT_C_SKILL] = lambda → HandlePacket&lt;C_SKILL&gt;  ..."
          style="rounded=0;whiteSpace=wrap;html=1;
                 fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;
                 align=left;spacingLeft=10;"
          vertex="1" parent="1">
          <mxGeometry x="184" y="275" width="700" height="75" as="geometry"/>
        </mxCell>

        <!-- SERVER SERVICE CREATION -->
        <mxCell id="s3" value="③ ServerService 생성
MakeShared&lt;ServerService&gt;(
  NetAddress(127.0.0.1:7777),       ← 바인딩 주소·포트
  MakeShared&lt;IocpCore&gt;(),           ← CreateIoCompletionPort() → IOCP 커널 오브젝트
  MakeShared&lt;GameSession&gt;,          ← Session 팩토리 (클로저)
  100                                ← maxSessionCount
)"
          style="rounded=0;whiteSpace=wrap;html=1;
                 fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;
                 align=left;spacingLeft=10;"
          vertex="1" parent="1">
          <mxGeometry x="134" y="390" width="800" height="100" as="geometry"/>
        </mxCell>

        <!-- SERVICE START -->
        <mxCell id="s4" value="④ service-&gt;Start()"
          style="rounded=0;whiteSpace=wrap;html=1;
                 fillColor=#1565c0;fontColor=#ffffff;strokeColor=#0d47a1;
                 fontSize=13;fontStyle=1;"
          vertex="1" parent="1">
          <mxGeometry x="384" y="530" width="300" height="50" as="geometry"/>
        </mxCell>

        <!-- START ACCEPT GROUP BACKGROUND -->
        <mxCell id="sa_bg" value=""
          style="rounded=1;whiteSpace=wrap;html=1;
                 fillColor=#fffde7;strokeColor=#f9a825;opacity=50;"
          vertex="1" parent="1">
          <mxGeometry x="84" y="610" width="1000" height="385" as="geometry"/>
        </mxCell>
        <mxCell id="sa_label" value="Listener::StartAccept(service) 내부"
          style="text;html=1;fontSize=12;fontStyle=1;fontColor=#e65100;"
          vertex="1" parent="1">
          <mxGeometry x="100" y="617" width="320" height="22" as="geometry"/>
        </mxCell>

        <mxCell id="sa1" value="A.  _socket = CreateSocket()  →  Listener 서버 소켓 생성 (WSASocket)"
          style="rounded=0;whiteSpace=wrap;html=1;
                 fillColor=#fff9c4;strokeColor=#f9a825;fontSize=11;
                 align=left;spacingLeft=10;"
          vertex="1" parent="1">
          <mxGeometry x="134" y="645" width="900" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="sa2" value="B.  IocpCore::Register(Listener)  →  CreateIoCompletionPort(listener_socket, iocpHandle)  [Listener 소켓 IOCP 등록]"
          style="rounded=0;whiteSpace=wrap;html=1;
