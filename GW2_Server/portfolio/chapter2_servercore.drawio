          vertex="1" parent="1">
          <mxGeometry x="134" y="795" width="900" height="185" as="geometry"/>
        </mxCell>
        <mxCell id="ra_label" value="D.  for i in 0 .. maxSessionCount(100):  RegisterAccept(acceptEvent)"
          style="text;html=1;fontSize=11;fontStyle=1;fontColor=#2e7d32;"
          vertex="1" parent="1">
          <mxGeometry x="150" y="801" width="600" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="ra1" value="service-&gt;CreateSession()
─ _sessionFactory() → MakeShared&lt;GameSession&gt;()
─ Session() 생성자 → _socket = CreateSocket()
─ session-&gt;SetService(this)
─ IocpCore::Register(session)  →  session 소켓 IOCP 등록"
          style="rounded=0;whiteSpace=wrap;html=1;
                 fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;
                 align=left;spacingLeft=8;"
          vertex="1" parent="1">
          <mxGeometry x="154" y="826" width="390" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="ra2" value="AcceptEx(
  listenerSocket,
  session-&gt;GetSocket(),      ← 미리 생성된 소켓
  recvBuffer.WritePos(),      ← 첫 수신 버퍼 포인터
  &amp;acceptEvent               ← OVERLAPPED 구조체
)
→  WSA_IO_PENDING  (비동기 등록 완료)"
          style="rounded=0;whiteSpace=wrap;html=1;
                 fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;
                 align=left;spacingLeft=8;"
          vertex="1" parent="1">
