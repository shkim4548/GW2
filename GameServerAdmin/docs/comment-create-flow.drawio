<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="21.0.0">
  <diagram name="CommentCreateFlow" id="comment-create-flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="2" value="댓글 / 대댓글 작성 흐름" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="150" y="20" width="860" height="40" as="geometry" />
        </mxCell>

        <!-- ===== STEP 1: Client ===== -->
        <mxCell id="10" value="User&#xa;/board/{postId} 게시글 상세 페이지에서&#xa;댓글 또는 대댓글 폼 제출" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="390" y="80" width="320" height="65" as="geometry" />
        </mxCell>

        <!-- ===== STEP 2: Authorize ===== -->
        <mxCell id="20" value="[Authorize] (클래스 전체)&#xa;로그인 여부 확인" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="415" y="185" width="270" height="80" as="geometry" />
        </mxCell>

        <mxCell id="21" value="로그인 페이지 리다이렉트" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="770" y="205" width="200" height="45" as="geometry" />
        </mxCell>

        <mxCell id="e10_20" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="10" target="20" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e20_21" value="미로그인" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="20" target="21" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== STEP 3: 댓글/대댓글 분기 ===== -->
        <mxCell id="30" value="어떤 폼을 제출했는가?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="415" y="305" width="270" height="75" as="geometry" />
        </mxCell>

        <mxCell id="e20_30" value="로그인" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="20" target="30" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==========================================
             왼쪽: 댓글 흐름
        ========================================== -->

        <!-- STEP 4A: 댓글 Controller -->
        <mxCell id="40" value="BoardCommentController&#xa;.CreateComment(postId, comment)&#xa;POST /board/{postId}/comments&#xa;[ValidateAntiForgeryToken]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="430" width="260" height="75" as="geometry" />
        </mxCell>

        <mxCell id="e30_40" value="댓글" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="30" target="40" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- STEP 5A: 댓글 Service -->
        <mxCell id="50" value="PublicCommentService&#xa;.CreateCommentAsync(postId, authorId, request)" style="swimlane;startSize=30;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="560" width="380" height="290" as="geometry" />
        </mxCell>

        <mxCell id="51" value="① Post 존재 여부 확인&#xa;_db.Posts.FindAsync(postId)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="50">
          <mxGeometry x="30" y="50" width="320" height="45" as="geometry" />
        </mxCell>

        <mxCell id="52" value="post.IsDeleted 확인&#xa;삭제된 게시글 → InvalidPostStateException" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="50">
          <mxGeometry x="30" y="115" width="320" height="45" as="geometry" />
        </mxCell>

        <mxCell id="53" value="② new Comment(postId, authorId, content)&#xa;→ Domain 유효성: 빈값 / 1000자 초과 체크" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="50">
          <mxGeometry x="30" y="180" width="320" height="50" as="geometry" />
        </mxCell>

        <mxCell id="54" value="③ _db.Comments.Add(comment)&#xa;   SaveChangesAsync()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="50">
          <mxGeometry x="30" y="245" width="320" height="35" as="geometry" />
        </mxCell>

        <mxCell id="e51_52" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="51" target="52" parent="50">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e52_53" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="52" target="53" parent="50">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e53_54" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="53" target="54" parent="50">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e40_50" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="40" target="50" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==========================================
             오른쪽: 대댓글 흐름
        ========================================== -->

        <!-- STEP 4B: 대댓글 Controller -->
        <mxCell id="60" value="BoardCommentController&#xa;.CreateReply(postId, parentCommentId, content)&#xa;POST /board/{postId}/comments/{parentCommentId}/replies&#xa;[ValidateAntiForgeryToken]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="760" y="430" width="300" height="75" as="geometry" />
        </mxCell>

        <mxCell id="e30_60" value="대댓글" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="30" target="60" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- STEP 5B: 대댓글 Service -->
        <mxCell id="70" value="PublicCommentService&#xa;.CreateReplyAsync(postId, parentCommentId, authorId, request)" style="swimlane;startSize=30;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="680" y="560" width="420" height="390" as="geometry" />
        </mxCell>

        <mxCell id="71" value="① Post 존재 여부 확인&#xa;post.IsDeleted → InvalidPostStateException" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="70">
          <mxGeometry x="30" y="50" width="360" height="45" as="geometry" />
        </mxCell>

        <mxCell id="72" value="② 부모 댓글 존재 여부 확인&#xa;→ ParentCommentNotFoundException" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="70">
          <mxGeometry x="30" y="115" width="360" height="45" as="geometry" />
        </mxCell>

        <mxCell id="73" value="③ parentComment.PostId != postId ?&#xa;→ InvalidParentCommentException&#xa;   (다른 게시글의 댓글에 대댓글 방지)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="70">
          <mxGeometry x="30" y="180" width="360" height="55" as="geometry" />
        </mxCell>

        <mxCell id="74" value="④ parentComment.Status == Deleted ?&#xa;→ InvalidParentCommentException&#xa;   (삭제된 댓글에 대댓글 방지)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="70">
          <mxGeometry x="30" y="255" width="360" height="55" as="geometry" />
        </mxCell>

        <mxCell id="75" value="⑤ new Comment(postId, parentCommentId, authorId, content)&#xa;   _db.Comments.Add(reply) → SaveChangesAsync()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="70">
          <mxGeometry x="30" y="330" width="360" height="45" as="geometry" />
        </mxCell>

        <mxCell id="e71_72" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="71" target="72" parent="70">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e72_73" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="72" target="73" parent="70">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e73_74" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="73" target="74" parent="70">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e74_75" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="74" target="75" parent="70">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e60_70" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="60" target="70" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== STEP 6: Redirect (공통) ===== -->
        <mxCell id="80" value="RedirectToAction(&quot;Detail&quot;, &quot;Board&quot;, new { id = postId })&#xa;→ GET /board/{postId} 로 이동" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="310" y="980" width="420" height="55" as="geometry" />
        </mxCell>

        <mxCell id="e50_80" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="50" target="80" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e70_80" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="70" target="80" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== STEP 7: 완료 ===== -->
        <mxCell id="90" value="게시글 상세 페이지 재표시&#xa;(작성한 댓글 / 대댓글 포함)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="1075" width="320" height="55" as="geometry" />
        </mxCell>

        <mxCell id="e80_90" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="80" target="90" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== 예외 경로 ===== -->
        <mxCell id="100" value="예외 발생 시 전역 핸들러&#xa;━━━━━━━━━━━━━━━━━━━━&#xa;PostNotFoundException          → 404&#xa;InvalidPostStateException      → 400&#xa;ParentCommentNotFoundException → 404&#xa;InvalidParentCommentException  → 400&#xa;ArgumentException (1000자 초과) → 400" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="30" y="980" width="260" height="120" as="geometry" />
        </mxCell>

        <!-- 댓글/대댓글 핵심 차이 박스 -->
        <mxCell id="110" value="댓글 vs 대댓글 검증 차이&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;댓글:   Post 존재 + IsDeleted 확인 (2단계)&#xa;대댓글: Post + 부모댓글 존재 + PostId 일치&#xa;       + 부모댓글 삭제 여부 확인 (4단계)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="730" y="980" width="380" height="95" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
