<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="21.0.0">
  <diagram name="AdminPostCreateFlow" id="admin-post-create-flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="2" value="Admin 게시글 작성 흐름 (현재 구조)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="20" width="760" height="40" as="geometry" />
        </mxCell>

        <!-- 안내 박스 -->
        <mxCell id="3" value="⚠️  Admin 전용 생성 경로 미구현&#xa;AdminUiPostController — Create 엔드포인트 없음&#xa;IAdminPostService      — CreateAsync() 없음&#xa;PostCreateRequest.cs   — 파일 존재하나 미사용&#xa;&#xa;현재 Admin은 일반 유저와 동일한 /board/create 경로를 사용" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="270" y="70" width="420" height="100" as="geometry" />
        </mxCell>

        <!-- ===== STEP 1: Admin ===== -->
        <mxCell id="10" value="Admin&#xa;GET /board/create 요청 (글쓰기 폼)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="200" width="300" height="55" as="geometry" />
        </mxCell>

        <!-- ===== STEP 2: Authorize ===== -->
        <mxCell id="20" value="[Authorize]&#xa;로그인 여부 확인" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="325" y="290" width="250" height="80" as="geometry" />
        </mxCell>

        <mxCell id="21" value="로그인 페이지 리다이렉트" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="310" width="200" height="45" as="geometry" />
        </mxCell>

        <mxCell id="e10_20" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="10" target="20" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e20_21" value="미로그인" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="20" target="21" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== STEP 3: 폼 표시 ===== -->
        <mxCell id="30" value="BoardController.Create() (GET)&#xa;→ 글쓰기 폼 View 표시&#xa;(User와 동일한 View)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="275" y="410" width="350" height="65" as="geometry" />
        </mxCell>

        <mxCell id="e20_30" value="Admin 로그인 확인" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="20" target="30" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== STEP 4: 제출 ===== -->
        <mxCell id="40" value="Admin이 제목 / 내용 입력 후 제출&#xa;POST /board/create (Form)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="515" width="300" height="55" as="geometry" />
        </mxCell>

        <mxCell id="e30_40" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="30" target="40" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== STEP 5: AntiForgery + ModelState ===== -->
        <mxCell id="50" value="[ValidateAntiForgeryToken] + ModelState 검사" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="605" width="300" height="75" as="geometry" />
        </mxCell>

        <mxCell id="51" value="400 / 폼 재표시" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="680" y="625" width="160" height="40" as="geometry" />
        </mxCell>

        <mxCell id="e40_50" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="40" target="50" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e50_51" value="실패" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="50" target="51" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== STEP 6: Service (핵심 분기) ===== -->
        <mxCell id="60" value="PublicPostService.CreateAsync(request)" style="swimlane;startSize=30;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="730" width="780" height="340" as="geometry" />
        </mxCell>

        <mxCell id="61" value="① App Validation&#xa;PostType / Title / Content 빈값 체크" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="60">
          <mxGeometry x="30" y="50" width="240" height="55" as="geometry" />
        </mxCell>

        <mxCell id="62" value="② EnsureAuthenticated()&#xa;비인증이면 UnauthorizedException" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="60">
          <mxGeometry x="510" y="50" width="240" height="55" as="geometry" />
        </mxCell>

        <!-- AuthorName 분기 — 핵심 -->
        <mxCell id="63" value="③ ActorType 분기&#xa;(User vs Admin)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="60">
          <mxGeometry x="290" y="130" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="64" value="ActorType == USER&#xa;Users 테이블 조회&#xa;→ AuthorName = Nickname" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="60">
          <mxGeometry x="60" y="145" width="200" height="55" as="geometry" />
        </mxCell>

        <mxCell id="65" value="ActorType == ADMIN ★&#xa;Admins 테이블 조회&#xa;→ AuthorName = LoginId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="60">
          <mxGeometry x="520" y="145" width="220" height="55" as="geometry" />
        </mxCell>

        <mxCell id="e63_64" value="USER" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="63" target="64" parent="60">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e63_65" value="ADMIN" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="63" target="65" parent="60">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="66" value="④ new Post(postType, title, content, ADMIN, adminId, loginId)&#xa;   → Domain 유효성 검사 (ValidateTitle / ValidateContent)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="60">
          <mxGeometry x="180" y="235" width="420" height="50" as="geometry" />
        </mxCell>

        <mxCell id="67" value="⑤ _db.Posts.Add(post) → SaveChangesAsync()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="60">
          <mxGeometry x="230" y="300" width="320" height="30" as="geometry" />
        </mxCell>

        <mxCell id="e61_63" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="61" target="63" parent="60">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e62_63" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="62" target="63" parent="60">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e64_66" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="64" target="66" parent="60">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e65_66" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="65" target="66" parent="60">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e66_67" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="66" target="67" parent="60">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e50_60" value="통과" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="50" target="60" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== STEP 7: Redirect ===== -->
        <mxCell id="70" value="RedirectToAction(&quot;Detail&quot;, new { id = created.PostId })&#xa;→ GET /board/{postId} 로 이동" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="240" y="1100" width="400" height="55" as="geometry" />
        </mxCell>

        <mxCell id="e60_70" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="60" target="70" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== STEP 8: 완료 ===== -->
        <mxCell id="80" value="게시글 상세 페이지 표시&#xa;(AuthorName = Admin LoginId로 표시됨)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="270" y="1195" width="340" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e70_80" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="70" target="80" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== User 흐름과 차이점 박스 ===== -->
        <mxCell id="90" value="User 흐름과의 차이점&#xa;━━━━━━━━━━━━━━━━━━━━━━&#xa;같은 점: /board/create URL, BoardController, PublicPostService&#xa;다른 점: ActorType = ADMIN → Admins.LoginId 조회" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="30" y="900" width="380" height="80" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
