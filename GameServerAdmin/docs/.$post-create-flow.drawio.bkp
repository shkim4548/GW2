        <!-- ===== STEP 4: 유저가 폼 제출 ===== -->
        <mxCell id="40" value="유저가 제목 / 내용 입력 후 제출&#xa;POST /board/create (Form)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="250" y="400" width="300" height="55" as="geometry" />
