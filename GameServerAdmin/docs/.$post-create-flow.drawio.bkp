        <mxCell id="e60_70" value="유효성 통과" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="60" target="70" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== STEP 8: Redirect ===== -->
        <mxCell id="80" value="RedirectToAction(&quot;Detail&quot;, new { id = created.PostId })&#xa;→ GET /board/{postId} 로 이동" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
