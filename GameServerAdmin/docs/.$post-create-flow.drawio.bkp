        <!-- ===== STEP 7: Service ===== -->
        <mxCell id="70" value="PublicPostService.CreateAsync(request)" style="swimlane;startSize=30;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="730" width="680" height="300" as="geometry" />
        </mxCell>

        <mxCell id="71" value="① App Validation&#xa;PostType / Title / Content 빈값 체크&#xa;→ 실패 시 RequestValidationException" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="70">
          <mxGeometry x="40" y="50" width="280" height="65" as="geometry" />
        </mxCell>

        <mxCell id="72" value="② EnsureAuthenticated()&#xa;비인증이면 UnauthorizedException" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="70">
          <mxGeometry x="360" y="50" width="270" height="65" as="geometry" />
        </mxCell>

        <mxCell id="73" value="③ AuthorName 조회&#xa;ActorType == USER  → Users.Nickname&#xa;ActorType == ADMIN → Admins.LoginId&#xa;그 외             → &quot;(알 수 없음)&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;" vertex="1" parent="70">
