        </mxCell>

        <mxCell id="74" value="④ new Post(postType, title, content,&#xa;          authorType, authorId, authorName)&#xa;  → Domain 유효성 검사 실행&#xa;  → ValidateTitle() / ValidateContent()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;" vertex="1" parent="70">
          <mxGeometry x="360" y="145" width="270" height="75" as="geometry" />
        </mxCell>

        <mxCell id="75" value="⑤ _db.Posts.Add(post)&#xa;   SaveChangesAsync()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="70">
          <mxGeometry x="200" y="240" width="270" height="45" as="geometry" />
