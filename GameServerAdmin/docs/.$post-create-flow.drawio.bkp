        <!-- ===== STEP 3: 폼 표시 ===== -->
        <mxCell id="30" value="BoardController.Create() (GET)&#xa;빈 PublicPostCreateViewModel 반환&#xa;→ 글쓰기 폼 View 표시" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
