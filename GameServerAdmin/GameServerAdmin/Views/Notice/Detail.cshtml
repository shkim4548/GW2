@model GameServerAdmin.Models.Notices.PublicApi.NoticeResponse

@{
    ViewData["Title"] = Model.Title;
    Layout = "_Layout";
}

<div class="mb-3">
    <a href="/notice" class="btn btn-outline-secondary btn-sm">← 목록</a>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-start">
        <div>
            @if (Model.IsPinned)
            {
                <span class="badge bg-danger me-2">고정</span>
            }
            <span class="badge bg-secondary me-2">@Model.Category</span>
            <h4 class="d-inline">@Model.Title</h4>
        </div>
        <small class="text-muted text-nowrap ms-3">
            조회 @Model.ViewCount
        </small>
    </div>
    <div class="card-body">
        <div class="text-muted small mb-3">
            @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")
            @if (Model.UpdatedAt.HasValue)
            {
                <span> · 수정: @Model.UpdatedAt.Value.ToString("yyyy-MM-dd HH:mm")</span>
            }
        </div>
        <pre style="white-space:pre-wrap; font-family:inherit;">@Model.Content</pre>
    </div>
</div>
