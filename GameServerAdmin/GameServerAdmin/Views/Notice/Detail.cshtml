@model GameServerAdmin.Models.Notices.PublicApi.NoticeResponse

@{
    ViewData["Title"] = Model.Title;
    Layout = "_Layout";
}

<div class="mb-2">
    <a href="/notice" class="text-muted small">&larr; 목록으로</a>
</div>

<div class="post-box mb-3">
    <div class="post-title-bar">
        <div class="d-flex align-items-center gap-2 mb-1">
            @if (Model.IsPinned)
            {
                <span class="notice-pin">고정</span>
            }
            <span class="badge bg-secondary fw-normal" style="font-size:0.75rem;">@Model.Category</span>
            <h5 class="mb-0 fw-bold">@Model.Title</h5>
        </div>
        <div class="post-meta">
            <span>@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
            @if (Model.UpdatedAt.HasValue)
            {
                <span class="mx-2">·</span>
                <span>수정: @Model.UpdatedAt.Value.ToString("yyyy-MM-dd HH:mm")</span>
            }
            <span class="mx-2">·</span>
            <span>조회 @Model.ViewCount</span>
        </div>
    </div>

    <div class="post-content">
        @Html.Raw(Model.Content)
    </div>
</div>
