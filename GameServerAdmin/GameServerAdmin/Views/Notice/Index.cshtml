@model GameServerAdmin.Models.Notices.PublicApi.NoticeListResponse

@{
    ViewData["Title"] = "공지사항";
    Layout = "_Layout";
}

<div class="board-wrap">
    <div class="board-header">
        <h6>공지사항</h6>
        <small class="text-muted">총 @Model.TotalCount 개</small>
    </div>

    <table class="board-table">
        <thead>
            <tr>
                <th class="td-num">번호</th>
                <th style="padding-left:12px;">제목</th>
                <th class="td-author" style="width:100px;">카테고리</th>
                <th class="td-date">날짜</th>
                <th class="td-view">조회</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Notices.Any())
            {
                foreach (var n in Model.Notices)
                {
                    <tr>
                        <td class="td-num">
                            @if (n.IsPinned)
                            {
                                <span class="notice-pin">고정</span>
                            }
                            else
                            {
                                @n.NoticeId
                            }
                        </td>
                        <td style="padding-left:12px;">
                            <a href="/notice/@n.NoticeId">
                                @if (n.IsPinned)
                                {
                                    <strong>@n.Title</strong>
                                }
                                else
                                {
                                    @n.Title
                                }
                            </a>
                        </td>
                        <td class="td-author">
                            <span class="badge bg-secondary fw-normal" style="font-size:0.75rem;">@n.Category</span>
                        </td>
                        <td class="td-date">@n.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="td-view">@n.ViewCount</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center py-5 text-muted">등록된 공지사항이 없습니다.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
