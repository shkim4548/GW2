@model GameServerAdmin.Models.Notices.PublicApi.NoticeListResponse

@{
    ViewData["Title"] = "공지사항";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">공지사항</h2>
    <small class="text-muted">총 @Model.TotalCount 개 (고정 @Model.PinnedCount 개)</small>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width:60px;">번호</th>
                    <th>제목</th>
                    <th style="width:120px;">카테고리</th>
                    <th style="width:160px;">작성일</th>
                    <th style="width:80px;" class="text-end">조회수</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Notices.Any())
                {
                    foreach (var n in Model.Notices)
                    {
                        <tr>
                            <td>
                                @if (n.IsPinned)
                                {
                                    <span class="badge bg-danger">고정</span>
                                }
                                else
                                {
                                    @n.NoticeId
                                }
                            </td>
                            <td>
                                <a href="/notice/@n.NoticeId">@n.Title</a>
                            </td>
                            <td>@n.Category</td>
                            <td>@n.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="text-end">@n.ViewCount</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">
                            등록된 공지사항이 없습니다.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
