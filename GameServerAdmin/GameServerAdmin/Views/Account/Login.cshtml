@model GameServerAdmin.Models.Auth.LoginRequest

@{
    ViewData["Title"] = "로그인";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5 col-lg-4">
        <div class="post-box">
            <div class="post-title-bar">
                <h5 class="mb-0 fw-bold">로그인</h5>
            </div>
            <div class="p-3">
                <form asp-action="Login" asp-controller="Account" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="UserName" class="form-label small fw-bold">아이디</label>
                        <input asp-for="UserName" class="form-control form-control-sm" />
                        <span asp-validation-for="UserName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label small fw-bold">비밀번호</label>
                        <input asp-for="Password" class="form-control form-control-sm" type="password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                    <div class="d-flex justify-content-between align-items-center">
                        <button type="submit" class="btn btn-primary btn-sm">로그인</button>
                        <a asp-action="Register" asp-controller="Account"
                           class="text-muted small">회원가입</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
