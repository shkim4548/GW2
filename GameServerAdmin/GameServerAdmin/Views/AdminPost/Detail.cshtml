@model GameServerAdmin.Models.Posts.AdminUi.AdminPostDetailViewModel

@{
    ViewData["Title"] = "게시글 상세 (Admin)";
}

<h2>게시글 상세 (Admin)</h2>

<div>
    <span>PostId: @Model.PostId</span><br />
    <span>Type: @Model.PostType</span><br />
    <span>Author: @Model.AuthorType (@Model.AuthorId)</span><br />
    <span>작성일: @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span><br />
    <span>삭제 여부: @(Model.IsDeleted ? "삭제됨" : "정상")</span><br />
    @if (Model.DeletedAt.HasValue)
    {
        <span>삭제일: @Model.DeletedAt.Value.ToString("yyyy-MM-dd HH:mm")</span>
        <br />
    }
</div>

<hr />

<div>
    <h3>내용</h3>
    <pre style="white-space:pre-wrap;">@Model.Content</pre>
</div>

<hr />

<div>
    @if (!Model.IsDeleted)
    {
        { {/* 정상 게시글: 수정 + 소프트 삭제 */} }
        <a asp-controller="AdminUiPost" asp-action="Edit" asp-route-id="@Model.PostId">수정</a>

        <form action="/admin/ui/posts/@Model.PostId/soft-delete"
              method="post"
              style="display:inline;">
            @Html.AntiForgeryToken()
            <button type="submit" onclick="return confirm('이 게시글을 삭제하시겠습니까?');">
                삭제
            </button>
        </form>
    }
    else
    {
        { {/* 삭제된 게시글: 복구 + 완전 삭제 (수정 버튼 없음) */} }
        <form action="/admin/ui/posts/@Model.PostId/restore"
              method="post"
              style="display:inline;">
            @Html.AntiForgeryToken()
            <button type="submit">
                복구
            </button>
        </form>

        <form action="/admin/ui/posts/@Model.PostId/hard-delete"
              method="post"
              style="display:inline;">
            @Html.AntiForgeryToken()
            <button type="submit" onclick="return confirm('정말 완전히 삭제하시겠습니까? 복구 불가합니다.');">
                완전 삭제
            </button>
        </form>
    }

    <a asp-controller="AdminUiPost" asp-action="Index">목록</a>
</div>
