@model GameServerAdmin.Models.Users.AdminUi.AdminUserListViewModel
@{
    ViewData["Title"] = "유저 관리";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h4 class="mb-3">유저 관리</h4>

{{-- 검색 폼 --}}
<form method="get" action="/admin/ui/users" class="row g-2 mb-4">
    <div class="col-auto">
        <input type="text" name="nickname" value="@Model.Nickname"
               class="form-control" placeholder="닉네임 검색" />
    </div>
    <div class="col-auto">
        <input type="number" name="userId" value="@Model.UserId"
               class="form-control" placeholder="UserId" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">검색</button>
        <a href="/admin/ui/users" class="btn btn-secondary">전체 목록</a>
    </div>
</form>

{{-- 결과 카운트 --}}
<p class="text-muted small">
    @if (Model.HasSearched)
    {
        <span>검색 결과: @Model.TotalCount 건</span>
    }
    else
    {
        <span>전체 유저: @Model.TotalCount 명</span>
    }
</p>

{{-- 유저 테이블 --}}
@if (Model.Results.Count == 0)
{
    <div class="alert alert-info">데이터가 없습니다.</div>
}
else
{
    <table class="table table-sm table-hover">
        <thead class="table-dark">
            <tr>
                <th>UserId</th>
                <th>닉네임</th>
                <th>레벨</th>
                <th>상태</th>
                <th>가입일</th>
                <th>최근 로그인</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Results)
            {
                <tr>
                    <td>@user.UserId</td>
                    <td>@user.Nickname</td>
                    <td>@user.Level</td>
                    <td>
                        @if (user.Status == "Banned")
                        {
                            <span class="badge bg-danger">정지</span>
                        }
                        else
                        {
                            <span class="badge bg-success">정상</span>
                        }
                    </td>
                    <td>@user.CreatedAt.ToString("yyyy-MM-dd")</td>
                    <td>@(user.LastLoginAt?.ToString("yyyy-MM-dd") ?? "-")</td>
                    <td>
                        <a href="/admin/ui/users/@user.UserId" class="btn btn-sm btn-outline-primary">상세</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (!Model.HasSearched && Model.TotalPages > 1)
    {
        <nav class="mt-3">
            <ul class="pagination pagination-sm">
                @if (Model.Page > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="/admin/ui/users?page=@(Model.Page - 1)">이전</a>
                    </li>
                }
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" href="/admin/ui/users?page=@i">@i</a>
                    </li>
                }
                @if (Model.Page < Model.TotalPages)
                {
                    <li class="page-item">
                        <a class="page-link" href="/admin/ui/users?page=@(Model.Page + 1)">다음</a>
                    </li>
                }
            </ul>
        </nav>
    }
}
