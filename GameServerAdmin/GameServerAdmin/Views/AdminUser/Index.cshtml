@model GameServerAdmin.Models.Users.AdminUi.AdminUserListViewModel
@{
    ViewData["Title"] = "유저 관리";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-filter d-flex gap-2 align-items-center">
    <form method="get" action="/admin/ui/users" class="d-flex gap-2 align-items-center flex-wrap">
        <input type="text" name="nickname" value="@Model.Nickname"
               class="form-control form-control-sm" style="width:160px;" placeholder="닉네임" />
        <input type="number" name="userId" value="@Model.UserId"
               class="form-control form-control-sm" style="width:120px;" placeholder="UserId" />
        <button type="submit" class="btn btn-primary btn-sm">검색</button>
        <a href="/admin/ui/users" class="btn btn-outline-secondary btn-sm">전체</a>
    </form>
</div>

<div class="admin-panel">
    <div class="admin-panel-header">
        <h6>
            @if (Model.HasSearched)
            {
                <span>검색 결과 @Model.TotalCount 건</span>
            }
            else
            {
                <span>전체 유저 @Model.TotalCount 명</span>
            }
        </h6>
    </div>

    @if (Model.Results.Count == 0)
    {
        <div class="p-4 text-center text-muted small">데이터가 없습니다.</div>
    }
    else
    {
        <table class="admin-table">
            <thead>
                <tr>
                    <th>UserId</th>
                    <th>닉네임</th>
                    <th>레벨</th>
                    <th>상태</th>
                    <th>가입일</th>
                    <th>최근 로그인</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Results)
                {
                    <tr>
                        <td class="text-muted">@user.UserId</td>
                        <td>@user.Nickname</td>
                        <td>@user.Level</td>
                        <td>
                            @if (user.Status == "Banned")
                            {
                                <span class="badge bg-danger fw-normal">정지</span>
                            }
                            else
                            {
                                <span class="badge bg-success fw-normal">정상</span>
                            }
                        </td>
                        <td class="text-muted">@user.CreatedAt.ToString("yyyy-MM-dd")</td>
                        <td class="text-muted">@(user.LastLoginAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                        <td>
                            <a href="/admin/ui/users/@user.UserId"
                               class="btn btn-sm btn-outline-secondary py-0 px-2">상세</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (!Model.HasSearched && Model.TotalPages > 1)
        {
            <div class="p-2 border-top">
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        @if (Model.Page > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="/admin/ui/users?page=@(Model.Page - 1)">이전</a>
                            </li>
                        }
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.Page ? "active" : "")">
                                <a class="page-link" href="/admin/ui/users?page=@i">@i</a>
                            </li>
                        }
                        @if (Model.Page < Model.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" href="/admin/ui/users?page=@(Model.Page + 1)">다음</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    }
</div>
