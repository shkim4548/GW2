@model GameServerAdmin.Models.Posts.PublicUi.PublicPostDetailViewModel

@{
    ViewData["Title"] = "게시글 상세";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">게시글 상세</h2>
    <div>
        <a asp-controller="Board" asp-action="Index" class="btn btn-outline-secondary btn-sm">
            목록으로
        </a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">
        <h4 class="mb-1">@Model.Title</h4>
        <div class="text-muted small">
            @Model.AuthorName · @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm") · 조회수 @Model.ViewCount
        </div>
    </div>
    <div class="card-body">
        <div class="mb-3">
            @Html.Raw(Model.Content) <!-- 실제 필드명/처리 방식에 맞게 -->
        </div>
    </div>
</div>

<div class="d-flex justify-content-between">
    <div>
        <!-- 필요시 이전/다음 글 -->
    </div>
    <div>
        <a asp-controller="Board" asp-action="Edit" asp-route-id="@Model.PostId"
           class="btn btn-secondary btn-sm">
            수정
        </a>
        <form asp-controller="Board"
              asp-action="Delete"
              asp-route-id="@Model.PostId"
              method="post"
              class="d-inline">
            <button type="submit" class="btn btn-danger btn-sm"
                    onclick="return confirm('삭제하시겠습니까?');">
                삭제
            </button>
        </form>
    </div>
</div>