@model GameServerAdmin.Models.Posts.PublicUi.PublicBoardDetailViewModel

@{
    ViewData["Title"] = "게시글";
    var post = Model.Post;
    var comments = Model.Comments;
}

<div class="mb-2">
    <a asp-controller="Board" asp-action="Index" class="text-muted small">&larr; 목록으로</a>
</div>

<div class="post-box mb-3">
    <div class="post-title-bar">
        <h5 class="mb-1 fw-bold">@post.Title</h5>
        <div class="post-meta">
            <span>@post.AuthorName</span>
            <span class="mx-2">·</span>
            <span>@post.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
            <span class="mx-2">·</span>
            <span>조회 @post.ViewCount</span>
        </div>
    </div>

    <div class="post-content">
        @Html.Raw(post.Content)
    </div>

    <div class="d-flex justify-content-end gap-1 p-2">
        @if (Model.CurrentUserId == post.AuthorId)
        {
            <a asp-controller="Board" asp-action="Edit" asp-route-id="@post.PostId"
               class="btn btn-outline-secondary btn-sm">수정</a>
            <form asp-controller="Board" asp-action="Delete" asp-route-id="@post.PostId" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger btn-sm"
                        onclick="return confirm('삭제하시겠습니까?');">
                    삭제
                </button>
            </form>
        }
    </div>
</div>

@* ── 댓글 영역 ── *@
<div class="board-wrap">
    <div class="board-header">
        <h6>
            댓글 @comments.CommentCount
            @if (comments.ReplyCount > 0)
            {
                <span class="text-muted fw-normal" style="font-size:0.8rem;">(대댓글 @comments.ReplyCount)</span>
            }
        </h6>
    </div>

    @foreach (var comment in comments.Comments)
    {
        <div class="comment-item">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <span class="comment-author">@comment.AuthorName</span>
                    <span class="comment-date">@comment.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                </div>
                <div class="d-flex gap-1">
                    @if (Model.IsAuthenticated)
                    {
                        <button type="button" class="btn btn-link btn-sm p-0 text-secondary"
                                style="font-size:0.8rem;" onclick="toggleReplyForm(@comment.Id)">
                            답글
                        </button>
                    }
                    @if (Model.CurrentUserId == comment.AuthorId)
                    {
                        <form action="/board/@post.PostId/comments/@comment.Id/delete" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-link btn-sm p-0 text-danger"
                                    style="font-size:0.8rem;"
                                    onclick="return confirm('댓글을 삭제하시겠습니까?');">
                                삭제
                            </button>
                        </form>
                    }
                </div>
            </div>
            <div class="comment-content">@comment.Content</div>

            @foreach (var reply in comment.Replies)
            {
                <div class="reply-item mt-1">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span style="color:#aaa; margin-right:4px;">└</span>
                            <span class="comment-author">@reply.AuthorName</span>
                            <span class="comment-date">@reply.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                        </div>
                        @if (Model.CurrentUserId == reply.AuthorId)
                        {
                            <form action="/board/@post.PostId/comments/@reply.Id/delete" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-link btn-sm p-0 text-danger"
                                        style="font-size:0.8rem;"
                                        onclick="return confirm('삭제하시겠습니까?');">
                                    삭제
                                </button>
                            </form>
                        }
                    </div>
                    <div class="comment-content">@reply.Content</div>
                </div>
            }

            @if (Model.IsAuthenticated)
            {
                <div id="reply-form-@comment.Id" class="mt-2" style="display:none;">
                    <form action="/board/@post.PostId/comments/@comment.Id/replies" method="post">
                        @Html.AntiForgeryToken()
                        <div class="input-group input-group-sm">
                            <input type="text" name="content" class="form-control"
                                   placeholder="대댓글 입력..." maxlength="1000" required />
                            <button type="submit" class="btn btn-primary">등록</button>
                        </div>
                    </form>
                </div>
            }
        </div>
    }

    @* 댓글 작성 *@
    <div class="p-3 border-top">
        @if (Model.IsAuthenticated)
        {
            <form action="/board/@post.PostId/comments" method="post">
                @Html.AntiForgeryToken()
                <textarea name="comment" class="form-control form-control-sm mb-2" rows="3"
                      placeholder="댓글을 입력하세요..." maxlength="1000" required></textarea>
                <div class="text-end">
                    <button type="submit" class="btn btn-primary btn-sm">댓글 등록</button>
                </div>
            </form>
        }
        else
        {
            <p class="text-muted mb-0 small">
                <a asp-controller="Account" asp-action="Login">로그인</a> 후 댓글을 작성할 수 있습니다.
            </p>
        }
    </div>
</div>

@section Scripts {
    <script>
        function toggleReplyForm(commentId) {
            const form = document.getElementById('reply-form-' + commentId);
            form.style.display = form.style.display === 'none' ? 'block' : 'none';
        }
    </script>
}
