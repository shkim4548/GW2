@model IEnumerable<GameServerAdmin.Models.Posts.PublicUi.PublicPostListItemViewModel>

@{
    ViewData["Title"] = "자유게시판";
    Layout = "_Layout";
}

<div class="board-wrap">
    <div class="board-header">
        <h6>자유게시판</h6>
        @if (User?.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Board" asp-action="Create" class="btn btn-primary btn-sm">글쓰기</a>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary btn-sm">로그인 후 글쓰기</a>
        }
    </div>

    <table class="board-table">
        <thead>
            <tr>
                <th class="td-num">번호</th>
                <th style="padding-left:12px;">제목</th>
                <th class="td-author">작성자</th>
                <th class="td-date">날짜</th>
                <th class="td-view">조회</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var post in Model)
                {
                    <tr>
                        <td class="td-num">@post.PostId</td>
                        <td style="padding-left:12px;">
                            <a asp-controller="Board" asp-action="Detail" asp-route-id="@post.PostId">
                                @post.Title
                            </a>
                        </td>
                        <td class="td-author">@post.AuthorName</td>
                        <td class="td-date">@post.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="td-view">@post.ViewCount</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center py-5 text-muted">등록된 게시글이 없습니다.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
