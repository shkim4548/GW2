@model List<GameServerAdmin.Models.Admin.AdminUi.AdminAccountListItemViewModel>

@{
    ViewData["Title"] = "Admin 계정 관리";
}

<div class="admin-panel">
    <div class="admin-panel-header">
        <h6>Admin 계정 목록</h6>
        <a asp-action="Create" class="btn btn-sm btn-primary py-0 px-2">+ 계정 추가</a>
    </div>

    <table class="admin-table">
        <thead>
            <tr>
                <th>아이디</th>
                <th>역할</th>
                <th>상태</th>
                <th>생성일</th>
                <th>마지막 로그인</th>
                <th>관리</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var admin in Model)
            {
                <tr class="@(admin.IsActive ? "" : "text-muted")">
                    <td>@admin.LoginId</td>
                    <td>@admin.Role</td>
                    <td>
                        @if (admin.IsActive)
                        {
                            <span class="badge bg-success fw-normal">활성</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary fw-normal">비활성</span>
                        }
                    </td>
                    <td>@admin.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@(admin.LastLoginAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                    <td>
                        @if (admin.IsActive)
                        {
                            <form asp-action="Deactivate" asp-route-adminId="@admin.AdminId"
                                  method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2"
                                        onclick="return confirm('@admin.LoginId 계정을 비활성화하시겠습니까?');">
                                    비활성화
                                </button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="Activate" asp-route-adminId="@admin.AdminId"
                                  method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-success py-0 px-2">
                                    활성화
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
