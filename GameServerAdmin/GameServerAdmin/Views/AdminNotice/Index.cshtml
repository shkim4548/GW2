@model GameServerAdmin.Common.Models.PagedResponse<GameServerAdmin.Models.Notices.AdminApi.AdminNoticeListItemDto>
@using GameServerAdmin.Domain.Notices

@{
    ViewData["Title"] = "공지 관리";
}

<div class="admin-panel">
    <div class="admin-panel-header">
        <h6>총 @Model.TotalCount 개</h6>
        <div class="d-flex gap-1">
            <a asp-controller="AdminUiNotice" asp-action="List" class="btn btn-sm btn-outline-secondary py-0 px-2">새로고침</a>
            <a asp-controller="AdminUiNotice" asp-action="Create" class="btn btn-sm btn-primary py-0 px-2">+ 새 공지</a>
        </div>
    </div>

    <table class="admin-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>제목</th>
                <th>카테고리</th>
                <th>상태</th>
                <th>고정</th>
                <th>조회</th>
                <th>작성일</th>
                <th>관리</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var n in Model.Items)
            {
                <tr>
                    <td class="text-muted">@n.NoticeId</td>
                    <td>
                        <a asp-controller="AdminUiNotice" asp-action="Detail" asp-route-noticeId="@n.NoticeId">
                            @n.Title
                        </a>
                        @if (n.DeletedAt != null)
                        {
                            <span class="badge bg-secondary fw-normal ms-1">삭제됨</span>
                        }
                    </td>
                    <td class="text-muted">@n.Category</td>
                    <td>
                        @if (n.Status.ToString() == "Published")
                        {
                            <span class="badge bg-success fw-normal">게시</span>
                        }
                        else if (n.Status.ToString() == "Hidden")
                        {
                            <span class="badge bg-secondary fw-normal">숨김</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark fw-normal">초안</span>
                        }
                    </td>
                    <td>@(n.IsPinned ? "📌" : "-")</td>
                    <td class="text-muted">@n.ViewCount</td>
                    <td class="text-muted">@n.CreatedAt.ToString("yyyy-MM-dd")</td>
                    <td style="white-space:nowrap;">
                        <a asp-controller="AdminUiNotice" asp-action="Edit"
                           asp-route-noticeId="@n.NoticeId"
                           class="btn btn-sm btn-outline-secondary py-0 px-2">수정</a>
                        @if (n.DeletedAt == null)
                        {
                            <form asp-controller="AdminUiNotice" asp-action="Delete" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="noticeId" value="@n.NoticeId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2"
                                        onclick="return confirm('삭제하시겠습니까?');">
                                    삭제
                                </button>
                            </form>
                        }
                        else
                        {
                            <form asp-controller="AdminUiNotice" asp-action="Restore" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="noticeId" value="@n.NoticeId" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary py-0 px-2">복구</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
