@model GameServerAdmin.Models.Notices.AdminApi.CreateNoticeRequest
@using GameServerAdmin.Domain.Notices

@{
    ViewData["Title"] = "공지 작성";
}

<div class="mb-2">
    <a asp-controller="AdminUiNotice" asp-action="List" class="text-muted small">&larr; 목록으로</a>
</div>

<div class="admin-panel" style="max-width:800px;">
    <div class="admin-panel-header">
        <h6>새 공지 작성</h6>
    </div>
    <div class="admin-panel-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="Title" class="form-label small fw-bold">제목</label>
                <input asp-for="Title" class="form-control form-control-sm" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Content" class="form-label small fw-bold">내용</label>
                <textarea asp-for="Content" class="form-control form-control-sm" rows="12"></textarea>
                <span asp-validation-for="Content" class="text-danger small"></span>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-auto">
                    <label asp-for="Category" class="form-label small fw-bold">카테고리</label>
                    <select asp-for="Category" class="form-select form-select-sm"
                            asp-items="Html.GetEnumSelectList<NoticeCategory>()"></select>
                </div>
                <div class="col-auto">
                    <label asp-for="Priority" class="form-label small fw-bold">우선순위</label>
                    <select asp-for="Priority" class="form-select form-select-sm"
                            asp-items="Html.GetEnumSelectList<NoticePriority>()"></select>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-auto">
                    <label asp-for="DisplayStartAt" class="form-label small fw-bold">노출 시작</label>
                    <input asp-for="DisplayStartAt" type="datetime-local" class="form-control form-control-sm" />
                </div>
                <div class="col-auto">
                    <label asp-for="DisplayEndAt" class="form-label small fw-bold">노출 종료</label>
                    <input asp-for="DisplayEndAt" type="datetime-local" class="form-control form-control-sm" />
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="List" class="btn btn-outline-secondary btn-sm">취소</a>
                <button type="submit" class="btn btn-primary btn-sm">등록</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
