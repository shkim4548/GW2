@model GameServerAdmin.Models.Notices.AdminApi.CreateNoticeRequest
@using GameServerAdmin.Domain.Notices

@{
    ViewData["Title"] = "공지 작성";
}

<h2>공지 작성</h2>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div>
        <label asp-for="Title"></label>
        <input asp-for="Title" />
        <span asp-validation-for="Title"></span>
    </div>

    <div>
        <label asp-for="Content"></label>
        <textarea asp-for="Content" rows="10"></textarea>
        <span asp-validation-for="Content"></span>
    </div>

    <div>
        <label asp-for="Category"></label>
        <select asp-for="Category" asp-items="Html.GetEnumSelectList<NoticeCategory>()"></select>
        <span asp-validation-for="Category"></span>
    </div>

    <div>
        <label asp-for="Priority"></label>
        <select asp-for="Priority" asp-items="Html.GetEnumSelectList<NoticePriority>()"></select>
        <span asp-validation-for="Priority"></span>
    </div>

    <div>
        <label asp-for="DisplayStartAt"></label>
        <input asp-for="DisplayStartAt" type="datetime-local" />
        <span asp-validation-for="DisplayStartAt"></span>
    </div>

    <div>
        <label asp-for="DisplayEndAt"></label>
        <input asp-for="DisplayEndAt" type="datetime-local" />
        <span asp-validation-for="DisplayEndAt"></span>
    </div>

    <button type="submit">등록</button>
    <a asp-action="List">목록</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}