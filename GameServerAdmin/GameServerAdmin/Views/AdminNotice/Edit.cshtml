@model GameServerAdmin.Models.Notices.AdminApi.AdminNoticeResponse

@{
    ViewData["Title"] = "공지 상세";
}

<div class="mb-2">
    <a asp-controller="AdminUiNotice" asp-action="List" class="text-muted small">&larr; 목록으로</a>
</div>

<div class="admin-panel">
    <div class="admin-panel-header">
        <h6>공지 #@Model.NoticeId</h6>
        <div class="d-flex gap-1 flex-wrap">
            <a asp-controller="AdminUiNotice" asp-action="Edit" asp-route-noticeId="@Model.NoticeId"
               class="btn btn-sm btn-outline-secondary py-0 px-2">수정</a>

            <form asp-controller="AdminUiNotice" asp-action="Publish" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="noticeId" value="@Model.NoticeId" />
                <button type="submit" class="btn btn-sm btn-success py-0 px-2">게시</button>
            </form>

            <form asp-controller="AdminUiNotice" asp-action="Hide" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="noticeId" value="@Model.NoticeId" />
                <button type="submit" class="btn btn-sm btn-outline-secondary py-0 px-2">숨김</button>
            </form>

            @if (!Model.IsPinned)
            {
                <form asp-controller="AdminUiNotice" asp-action="Pin" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="noticeId" value="@Model.NoticeId" />
                    <button type="submit" class="btn btn-sm btn-outline-secondary py-0 px-2">고정</button>
                </form>
            }
            else
            {
                <form asp-controller="AdminUiNotice" asp-action="Unpin" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="noticeId" value="@Model.NoticeId" />
                    <button type="submit" class="btn btn-sm btn-outline-secondary py-0 px-2">고정해제</button>
                </form>
            }

            @if (!Model.IsCommentEnabled)
            {
                <form asp-controller="AdminUiNotice" asp-action="EnableComments" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="noticeId" value="@Model.NoticeId" />
                    <button type="submit" class="btn btn-sm btn-outline-secondary py-0 px-2">댓글허용</button>
                </form>
            }
            else
            {
                <form asp-controller="AdminUiNotice" asp-action="DisableComments" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="noticeId" value="@Model.NoticeId" />
                    <button type="submit" class="btn btn-sm btn-outline-secondary py-0 px-2">댓글비활성</button>
                </form>
            }

            @if (Model.DeletedAt == null)
            {
                <form asp-controller="AdminUiNotice" asp-action="Delete" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="noticeId" value="@Model.NoticeId" />
                    <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2"
                            onclick="return confirm('삭제하시겠습니까?');">
                        삭제
                    </button>
                </form>
            }
            else
            {
                <form asp-controller="AdminUiNotice" asp-action="Restore" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="noticeId" value="@Model.NoticeId" />
                    <button type="submit" class="btn btn-sm btn-outline-secondary py-0 px-2">복구</button>
                </form>
            }
        </div>
    </div>

    <div class="admin-panel-body">
        <table class="detail-table mb-3">
            <tbody>
                <tr><th>카테고리</th><td>@Model.Category</td></tr>
                <tr><th>우선순위</th><td>@Model.Priority</td></tr>
                <tr><th>상태</th><td>@Model.Status</td></tr>
                <tr><th>고정</th><td>@(Model.IsPinned ? "Y" : "N")</td></tr>
                <tr><th>댓글 허용</th><td>@(Model.IsCommentEnabled ? "Y" : "N")</td></tr>
                <tr><th>조회수</th><td>@Model.ViewCount</td></tr>
                <tr><th>노출 시작</th><td>@(Model.DisplayStartAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td></tr>
                <tr><th>노출 종료</th><td>@(Model.DisplayEndAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td></tr>
                <tr><th>작성일</th><td>@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td></tr>
                <tr><th>수정일</th><td>@(Model.UpdatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td></tr>
                <tr><th>삭제일</th><td>@(Model.DeletedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td></tr>
            </tbody>
        </table>

        <div style="background:#fafafa; border:1px solid #eee; padding:16px; white-space:pre-wrap; font-size:0.875rem; line-height:1.7;">@Model.Content</div>
    </div>
</div>
