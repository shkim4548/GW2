@model GameServerAdmin.Common.Models.PagedResponse<GameServerAdmin.Models.Comments.AdminApi.AdminCommentListItemDto>

@{
    ViewData["Title"] = "댓글 관리";
}

<h2>댓글 관리</h2>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>PostId</th>
            <th>내용</th>
            <th>작성자</th>
            <th>상태</th>
            <th>생성일</th>
            <th>액션</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.PostId</td>
                <td>@item.Content</td>
                @*<td>@item.AuthorName</td>*@
                <td>@item.Status</td>
                <td>@item.CreatedAt</td>
                <td>
                    @if (item.Status.ToString() != "Deleted")
                    {
                        <form asp-action="Delete" method="post" style="display:inline;">
                            <input type="hidden" name="commentId" value="@item.Id" />
                            <button type="submit">삭제</button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Restore" method="post" style="display:inline;">
                            <input type="hidden" name="commentId" value="@item.Id" />
                            <button type="submit">복구</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>