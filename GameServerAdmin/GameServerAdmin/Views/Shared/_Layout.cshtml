﻿<!DOCTYPE html>
 <html lang="ko">
 <head>
     <meta charset="utf-8" />
     <title>@ViewData["Title"] - GameServerAdmin</title>
     <meta name="viewport" content="width=device-width, initial-scale=1" />
    
     <!-- Bootstrap CSS 추가 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    
    <!-- 기존 site.css는 Bootstrap 아래에 둔다 -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
 </head>
 <body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom mb-3">
            <div class="container">
                <!-- 사이트 이름 -->
                <a class="navbar-brand" asp-controller="Board" asp-action="Index">
                    GameServerAdmin
                </a>

                <!-- 모바일 토글 버튼 -->
                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- 메뉴 영역 -->
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <!-- 왼쪽 메뉴 -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="PublicNotice" asp-action="Index">
                                공지사항
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Board" asp-action="Index">
                                게시판
                            </a>
                        </li>
                    </ul>

                    <!-- 오른쪽 메뉴 -->
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">
                                로그인
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
    <main class="py-4 mb-5">
        @RenderBody()
    </main>
 
     @RenderSection("Scripts", required: false)
        <div style="d-flex gap-2 align-items-center justify-content-end mb-4">
        @if (User?.Identity?.IsAuthenticated == true)
        {
            <span>안녕하세요, @User.Identity.Name</span>

            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit">로그아웃</button>
            </form>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-sm">로그인</a>
        }
    </div>
    </div>
    <footer class="class= border-top footer text-muted pt-3 pb-4">
        <div class="container">
            &copy; @DateTime.Now.Year - GameServerAdmin
        </div>
    </footer>
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
 </body>
 </html>