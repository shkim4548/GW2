<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - GW2 커뮤니티</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&display=swap" rel="stylesheet" />
    <style>
        body {
            font-family: 'Noto Sans KR', sans-serif;
            background: #f5f6f7;
            font-size: 14px;
        }

        .site-header {
            background: #1c1d1f;
        }

            .site-header .navbar-brand {
                color: #fff;
                font-weight: 700;
                font-size: 1.1rem;
            }

            .site-header .nav-link {
                color: #bbb;
                font-size: 0.9rem;
                padding: 0.5rem 0.75rem;
            }

                .site-header .nav-link:hover, .site-header .nav-link.active {
                    color: #fff;
                }

            .site-header .user-info {
                color: #bbb;
                font-size: 0.85rem;
            }

        .board-wrap {
            background: #fff;
            border: 1px solid #dde1e7;
        }

        .board-header {
            padding: 10px 16px;
            border-bottom: 2px solid #333;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .board-header h6 {
                margin: 0;
                font-weight: 700;
                font-size: 0.95rem;
            }

        .board-table {
            width: 100%;
            border-collapse: collapse;
        }

            .board-table thead th {
                font-size: 0.78rem;
                color: #888;
                font-weight: 500;
                padding: 7px 8px;
                border-bottom: 1px solid #dde1e7;
                background: #fafafa;
            }

            .board-table tbody tr {
                border-bottom: 1px solid #f0f0f0;
            }

                .board-table tbody tr:hover td {
                    background: #f8f9fa;
                }

            .board-table tbody td {
                padding: 8px 8px;
                vertical-align: middle;
                font-size: 0.875rem;
            }

            .board-table a {
                color: #1a1a2e;
                text-decoration: none;
            }

                .board-table a:hover {
                    text-decoration: underline;
                    color: #0066cc;
                }

            .board-table .td-num {
                width: 60px;
                text-align: center;
                color: #aaa;
                font-size: 0.8rem;
            }

            .board-table .td-author {
                width: 110px;
                color: #666;
            }

            .board-table .td-date {
                width: 130px;
                color: #999;
                font-size: 0.8rem;
            }

            .board-table .td-view {
                width: 60px;
                text-align: right;
                color: #999;
                font-size: 0.8rem;
                padding-right: 12px;
            }

        .post-box {
            background: #fff;
            border: 1px solid #dde1e7;
        }

        .post-title-bar {
            padding: 16px;
            border-bottom: 1px solid #eee;
        }

        .post-meta {
            font-size: 0.82rem;
            color: #888;
            margin-top: 6px;
        }

        .post-content {
            padding: 20px 16px;
            min-height: 200px;
            line-height: 1.8;
            font-size: 0.9rem;
            border-bottom: 1px solid #eee;
        }

        .comment-item {
            padding: 10px 16px;
            border-bottom: 1px solid #f0f0f0;
        }

            .comment-item:last-child {
                border-bottom: none;
            }

        .reply-item {
            padding: 8px 16px 8px 36px;
            background: #fafafa;
            border-bottom: 1px solid #f0f0f0;
        }

        .comment-author {
            font-weight: 600;
            font-size: 0.85rem;
        }

        .comment-date {
            font-size: 0.78rem;
            color: #aaa;
            margin-left: 8px;
        }

        .comment-content {
            font-size: 0.875rem;
            margin-top: 4px;
        }

        .notice-pin {
            background: #dc3545;
            color: #fff;
            font-size: 0.7rem;
            padding: 1px 5px;
            border-radius: 3px;
        }
    </style>
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg py-2">
            <div class="container-lg">
                <a class="navbar-brand" asp-controller="Board" asp-action="Index">GW2 커뮤니티</a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Notice" asp-action="Index">공지사항</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Board" asp-action="Index">자유게시판</a></li>
                    </ul>
                    <ul class="navbar-nav align-items-center gap-2">
                        @if (User?.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item user-info">@User.Identity.Name</li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-secondary btn-sm py-0 px-2" style="font-size:0.8rem;">로그아웃</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">로그인</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Register">회원가입</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-lg py-4">
        <main>
            @RenderBody()
        </main>
    </div>

    <footer class="py-3 mt-2 border-top" style="background:#fff;">
        <div class="container-lg">
            <small class="text-muted">&copy; @DateTime.Now.Year GW2 커뮤니티</small>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
