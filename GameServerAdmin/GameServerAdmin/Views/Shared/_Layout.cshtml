﻿<!DOCTYPE html>
 <html lang="ko">
 <head>
     <meta charset="utf-8" />
     <title>@ViewData["Title"] - GameServerAdmin</title>
     <meta name="viewport" content="width=device-width, initial-scale=1" />
    
     <!-- Bootstrap CSS 추가 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    
    <!-- 기존 site.css는 Bootstrap 아래에 둔다 -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
 </head>
 <body>
    <header style="padding:16px; border-bottom:1px solid #e5e7eb;">
        <nav style="display:flex; gap:12px; align-items:center;">
            <a asp-controller="Board" asp-action="Index">게시판</a>
            <span style="opacity:.4;">|</span>
            <a asp-controller="AdminUiPost" asp-action="Index">관리자</a>
        </nav>
    </header>

    <main style="padding:24px;">
        @RenderBody()
    </main>
 
     @RenderSection("Scripts", required: false)
    <div style="display:flex; gap:12px; align-items:center; justify-content:flex-end;">
        @if (User?.Identity?.IsAuthenticated == true)
        {
            <span>안녕하세요, @User.Identity.Name</span>

            <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline;">
                @Html.AntiForgeryToken()
                <button type="submit">로그아웃</button>
            </form>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login">로그인</a>
        }
    </div>
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
 </body>
 </html>