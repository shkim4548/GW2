<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="21.0.0">
  <diagram name="GachaFlow" id="gacha-flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="2" value="POST /api/gacha/{poolId}/pull/single 전체 흐름" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="700" height="40" as="geometry" />
        </mxCell>

        <!-- ===== LAYER 1: Middleware ===== -->
        <mxCell id="10" value="LAYER 1 : Middleware" style="swimlane;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="1420" height="120" as="geometry" />
        </mxCell>

        <mxCell id="11" value="Client&#xa;(JWT 포함 요청)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="10">
          <mxGeometry x="40" y="40" width="160" height="60" as="geometry" />
        </mxCell>

        <mxCell id="12" value="[Authorize]&#xa;JWT 검증" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="10">
          <mxGeometry x="280" y="20" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="13" value="401 Unauthorized" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="10">
          <mxGeometry x="540" y="40" width="160" height="50" as="geometry" />
        </mxCell>

        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="11" target="12" parent="10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" value="실패" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="12" target="13" parent="10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== LAYER 2: Controller ===== -->
        <mxCell id="20" value="LAYER 2 : Controller" style="swimlane;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="1420" height="110" as="geometry" />
        </mxCell>

        <mxCell id="21" value="GachaController.PullSingle(poolId)&#xa;URL 파라미터 바인딩 → Service 호출만 함" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="20">
          <mxGeometry x="480" y="30" width="320" height="55" as="geometry" />
        </mxCell>

        <!-- Middleware → Controller -->
        <mxCell id="e20" value="성공" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="12" target="21" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== LAYER 3: Service ===== -->
        <mxCell id="30" value="LAYER 3 : Service — ExecutePullAsync" style="swimlane;startSize=30;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="350" width="1420" height="420" as="geometry" />
        </mxCell>

        <!-- DB 조회 박스들 -->
        <mxCell id="31" value="① GachaPools&#xa;WHERE pool_id = ?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="30">
          <mxGeometry x="40" y="60" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="32" value="② PlayerGachaCurrencies&#xa;WHERE user_id = ?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="30">
          <mxGeometry x="260" y="60" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="33" value="③ GachaPoolItems&#xa;WHERE pool_id = ?&#xa;(+ Item Include)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="30">
          <mxGeometry x="40" y="140" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="34" value="④ PlayerGachaPities&#xa;WHERE user_id = ?&#xa;AND pool_id = ?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="30">
          <mxGeometry x="260" y="140" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="35" value="⑤ PlayerGachaInventories&#xa;WHERE user_id = ?&#xa;→ HashSet 변환" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="30">
          <mxGeometry x="150" y="225" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- 메모리 연산 -->
        <mxCell id="36" value="pool.IsAvailable(now)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="30">
          <mxGeometry x="560" y="60" width="200" height="45" as="geometry" />
        </mxCell>
        <mxCell id="37" value="currency.Subtract(cost)&#xa;※ 부족 시 DomainException" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="30">
          <mxGeometry x="800" y="60" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="38" value="pity.Increment()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="30">
          <mxGeometry x="560" y="135" width="200" height="45" as="geometry" />
        </mxCell>

        <mxCell id="39" value="PullCount &gt;= PityThreshold?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="30">
          <mxGeometry x="800" y="120" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="40" value="Grade &gt;= PityGrade 필터 후&#xa;WeightedRandom + pity.Reset()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="30">
          <mxGeometry x="700" y="220" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="41" value="전체 poolItems로&#xa;WeightedRandom" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="30">
          <mxGeometry x="960" y="220" width="200" height="55" as="geometry" />
        </mxCell>

        <mxCell id="42" value="중복(HashSet)?&#xa;YES → currency.Add(보상)&#xa;NO  → new Inventory 추가" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="30">
          <mxGeometry x="800" y="300" width="260" height="60" as="geometry" />
        </mxCell>

        <!-- SaveChanges -->
        <mxCell id="43" value="SaveChangesAsync() — 단일 트랜잭션&#xa;player_gacha_currency  UPDATE&#xa;player_gacha_pity      UPDATE&#xa;player_gacha_inventory INSERT&#xa;gacha_history          INSERT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;" vertex="1" parent="30">
          <mxGeometry x="480" y="310" width="280" height="90" as="geometry" />
        </mxCell>

        <!-- Service 내부 엣지 -->
        <mxCell id="e31" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="31" target="33" parent="30">
