        <!-- ===== LAYER 4: Domain ===== -->
        <mxCell id="50" value="LAYER 4 : Domain (규칙 보유)" style="swimlane;startSize=30;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="790" width="1420" height="110" as="geometry" />
        </mxCell>

        <mxCell id="51" value="GachaPool&#xa;.IsAvailable()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="50">
          <mxGeometry x="80" y="35" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="52" value="PlayerGachaCurrency&#xa;.Subtract() / .Add()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="50">
          <mxGeometry x="320" y="35" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="53" value="PlayerGachaPity&#xa;.Increment() / .Reset()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="50">
          <mxGeometry x="580" y="35" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="54" value="GachaHistory&#xa;(생성자, 불변)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="50">
          <mxGeometry x="840" y="35" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="55" value="DomainException&#xa;→ 400 Bad Request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="50">
          <mxGeometry x="1100" y="35" width="180" height="50" as="geometry" />
