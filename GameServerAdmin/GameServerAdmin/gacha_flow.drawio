        <mxCell id="60" value="GachaPullResponse { Results, RemainCurrency }&#xa;→ 200 OK → Client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1">
